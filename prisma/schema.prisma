generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  bio           String?
  timezone      String    @default("UTC")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  goals            Goal[]
  missions         Mission[]
  missionLogs      MissionLog[]
  achievements     UserAchievement[]
  streak           Streak?
  analytics        DailyAnalytic[]
  settings         UserSettings?
  habits           Habit[]
  habitCompletions HabitCompletion[]
  journals         Journal[]
  notifications    Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  ABANDONED
}

enum GoalCategory {
  HEALTH
  FITNESS
  LEARNING
  CAREER
  FINANCE
  RELATIONSHIPS
  MINDFULNESS
  CREATIVITY
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Goal {
  id          String       @id @default(cuid())
  userId      String
  title       String
  description String?      @db.Text
  category    GoalCategory @default(OTHER)
  priority    Priority     @default(MEDIUM)
  status      GoalStatus   @default(ACTIVE)
  targetDate  DateTime?
  progress    Int          @default(0)
  color       String       @default("#2563EB")
  icon        String       @default("target")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  missions Mission[]

  @@index([userId])
}

enum MissionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum MissionDifficulty {
  EASY
  MEDIUM
  HARD
  EPIC
}

model Mission {
  id           String            @id @default(cuid())
  userId       String
  goalId       String?
  title        String
  description  String?           @db.Text
  difficulty   MissionDifficulty @default(MEDIUM)
  xpReward     Int               @default(100)
  status       MissionStatus     @default(PENDING)
  dueDate      DateTime?
  completedAt  DateTime?
  isRecurring  Boolean           @default(false)
  recurringDay Int?
  order        Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  logs MissionLog[]

  @@index([userId])
  @@index([goalId])
}

model MissionLog {
  id        String   @id @default(cuid())
  userId    String
  missionId String
  date      DateTime @default(now())
  notes     String?  @db.Text
  xpEarned  Int      @default(0)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([missionId])
}

enum HabitCategory {
  HEALTH
  FITNESS
  LEARNING
  CAREER
  FINANCE
  RELATIONSHIPS
  MINDFULNESS
  CREATIVITY
  OTHER
}

enum HabitFrequency {
  DAILY
  WEEKDAYS
  WEEKENDS
  CUSTOM
}

model Habit {
  id               String         @id @default(cuid())
  userId           String
  name             String
  description      String?        @db.Text
  category         HabitCategory  @default(OTHER)
  priority         Priority       @default(MEDIUM)
  frequency        HabitFrequency @default(DAILY)
  customDays       Int[]
  color            String         @default("#2563EB")
  icon             String         @default("check-circle")
  xpReward         Int            @default(25)
  isArchived       Boolean        @default(false)
  reminderTime     String?
  currentStreak    Int            @default(0)
  longestStreak    Int            @default(0)
  totalCompletions Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions HabitCompletion[]

  @@index([userId])
}

model HabitCompletion {
  id        String   @id @default(cuid())
  userId    String
  habitId   String
  date      DateTime @db.Date
  skipped   Boolean  @default(false)
  notes     String?
  xpEarned  Int      @default(25)
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId])
  @@index([habitId])
}

model Journal {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  title     String?
  content   String   @db.Text
  mood      Mood     @default(NEUTRAL)
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

enum Mood {
  GREAT
  GOOD
  NEUTRAL
  BAD
  AWFUL
}

model Streak {
  id             String    @id @default(cuid())
  userId         String    @unique
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime?
  totalXp        Int       @default(0)
  level          Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AchievementType {
  STREAK
  MISSIONS
  HABITS
  GOALS
  XP
  JOURNAL
  SPECIAL
}

model Achievement {
  id          String          @id @default(cuid())
  name        String
  description String
  icon        String
  type        AchievementType
  threshold   Int
  xpReward    Int             @default(500)
  rarity      String          @default("common")
  createdAt   DateTime        @default(now())

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model DailyAnalytic {
  id                String   @id @default(cuid())
  userId            String
  date              DateTime @db.Date
  missionsTotal     Int      @default(0)
  missionsCompleted Int      @default(0)
  habitsTotal       Int      @default(0)
  habitsCompleted   Int      @default(0)
  xpEarned          Int      @default(0)
  goalsActive       Int      @default(0)
  goalsCompleted    Int      @default(0)
  productivityScore Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

enum NotificationType {
  ACHIEVEMENT
  STREAK
  REMINDER
  SYSTEM
  LEVEL_UP
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  emailNotifications Boolean  @default(true)
  pushNotifications  Boolean  @default(true)
  dailyReminder      Boolean  @default(true)
  reminderTime       String   @default("09:00")
  weeklyReport       Boolean  @default(true)
  profileVisibility  String   @default("private")
  theme              String   @default("dark")
  accentColor        String   @default("#2563EB")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
